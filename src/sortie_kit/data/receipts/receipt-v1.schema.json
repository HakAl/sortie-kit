{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sortie-kit receipt v1",
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "commit"
            },
            "commit": {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
              "maxLength": 64
            }
          },
          "required": [
            "kind",
            "commit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plan"
            },
            "artifact": {
              "$ref": "#/$defs/artifact"
            }
          },
          "required": [
            "kind",
            "artifact"
          ],
          "additionalProperties": false
        }
      ]
    },
    "fallback": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "enum": [
            "agy-review",
            "review"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        }
      },
      "required": [
        "tool",
        "entrypoint",
        "model"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "expected_exit": {
          "type": "integer",
          "minimum": -255,
          "maximum": 255
        },
        "exit_status": {
          "type": "integer",
          "minimum": -255,
          "maximum": 255
        },
        "output": {
          "$ref": "#/$defs/artifact"
        }
      },
      "required": [
        "command",
        "timeout_seconds",
        "expected_exit",
        "exit_status",
        "output"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "maxLength": 64
        },
        "worktree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "expected_exit": {
          "type": "integer",
          "minimum": -255,
          "maximum": 255
        },
        "exit_status": {
          "type": "integer",
          "minimum": -255,
          "maximum": 255
        },
        "output": {
          "$ref": "#/$defs/artifact"
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "observed_behavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "matched",
            "mismatched",
            "unavailable"
          ]
        }
      },
      "required": [
        "commit",
        "worktree",
        "command",
        "timeout_seconds",
        "expected_exit",
        "exit_status",
        "output",
        "expected_behavior",
        "observed_behavior",
        "outcome"
      ],
      "additionalProperties": false
    },
    "invocation": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "enum": [
            "agy-review",
            "review"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "minItems": 1,
          "maxItems": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "model_family": {
          "type": "string",
          "enum": [
            "GPT",
            "Claude",
            "Gemini"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "cross-family",
            "same-family"
          ]
        },
        "fallback_reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "checks",
            "verdict"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "incomplete",
            "failed"
          ]
        },
        "exit_status": {
          "type": "integer",
          "minimum": -255,
          "maximum": 255
        },
        "raw_output": {
          "$ref": "#/$defs/artifact"
        }
      },
      "required": [
        "tool",
        "version",
        "entrypoint",
        "argv",
        "model",
        "model_family",
        "mode",
        "fallback_reason",
        "target",
        "purpose",
        "status",
        "exit_status",
        "raw_output"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128
        },
        "disposition": {
          "type": "string",
          "enum": [
            "fixed",
            "rejected",
            "open"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "disposition",
        "reason"
      ],
      "additionalProperties": false
    },
    "reproduction": {
      "type": "object",
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128
        },
        "baseline": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "run"
                },
                "run": {
                  "$ref": "#/$defs/run"
                }
              },
              "required": [
                "kind",
                "run"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "not_applicable"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "\\S"
                }
              },
              "required": [
                "kind",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        },
        "candidate": {
          "$ref": "#/$defs/run"
        },
        "harness": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "harness_reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "assessment": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "reproduced",
                "not_reproduced",
                "inconclusive",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "report": {
              "$ref": "#/$defs/artifact"
            }
          },
          "required": [
            "status",
            "reason",
            "report"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "finding_id",
        "baseline",
        "candidate",
        "harness",
        "harness_reason",
        "assessment"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "plan": {
          "$ref": "#/$defs/artifact"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      },
      "required": [
        "plan",
        "summary"
      ],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "maxLength": 64
        },
        "touched_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "no_checks_reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "commit",
        "touched_files",
        "checks",
        "no_checks_reason"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/target"
        },
        "implementer_family": {
          "type": "string",
          "enum": [
            "GPT",
            "Claude",
            "Gemini"
          ]
        },
        "invocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invocation"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "verdict": {
          "type": "string",
          "enum": [
            "ACCEPT",
            "CHANGES"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "reproductions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reproduction"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "reproduction_note": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "target",
        "implementer_family",
        "invocations",
        "verdict",
        "findings",
        "reproductions",
        "reproduction_note"
      ],
      "additionalProperties": false
    },
    "acknowledgment": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "acknowledged",
            "not_acknowledged"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "evidence",
        "reason"
      ],
      "additionalProperties": false
    },
    "stop": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "stopped",
            "unknown"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "seat",
            "toolkit"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "scope",
        "evidence",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "shift_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "role": {
      "type": "string",
      "enum": [
        "driver",
        "builder"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "plan",
        "build",
        "review",
        "acknowledgment",
        "stop"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "brief": {
      "$ref": "#/$defs/artifact"
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "receipt_id",
    "version",
    "shift_id",
    "task_id",
    "request_id",
    "role",
    "phase",
    "round",
    "brief",
    "data"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "type": "string",
            "const": "plan"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/plan"
          },
          "role": {
            "type": "string",
            "const": "builder"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "type": "string",
            "const": "build"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/build"
          },
          "role": {
            "type": "string",
            "const": "builder"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "type": "string",
            "const": "review"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/review"
          },
          "role": {
            "type": "string",
            "const": "builder"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "type": "string",
            "const": "acknowledgment"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/acknowledgment"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "type": "string",
            "const": "stop"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/stop"
          }
        }
      }
    }
  ]
}
