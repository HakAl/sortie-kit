{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sortie-kit receipt v3",
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "commit"
            },
            "commit": {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
              "maxLength": 64
            }
          },
          "required": [
            "kind",
            "commit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plan"
            },
            "artifact": {
              "$ref": "#/$defs/artifact"
            }
          },
          "required": [
            "kind",
            "artifact"
          ],
          "additionalProperties": false
        }
      ]
    },
    "check": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "expected_exit": {
          "type": "integer",
          "minimum": -255,
          "maximum": 255
        },
        "exit_status": {
          "type": "integer",
          "minimum": -255,
          "maximum": 255
        },
        "output": {
          "$ref": "#/$defs/artifact"
        }
      },
      "required": [
        "command",
        "timeout_seconds",
        "expected_exit",
        "exit_status",
        "output"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "plan": {
          "$ref": "#/$defs/artifact"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "answers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answer"
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "plan",
        "summary",
        "answers"
      ],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "maxLength": 64
        },
        "touched_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "no_checks_reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "answers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answer"
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "commit",
        "touched_files",
        "checks",
        "no_checks_reason",
        "answers"
      ],
      "additionalProperties": false
    },
    "acknowledgment": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "acknowledged",
            "not_acknowledged"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "evidence",
        "reason"
      ],
      "additionalProperties": false
    },
    "stop": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "stopped",
            "unknown"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "seat",
            "toolkit"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "scope",
        "evidence",
        "reason"
      ],
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "maxLength": 64
        },
        "disposition": {
          "type": "string",
          "enum": [
            "fixed",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "disposition",
        "reason",
        "evidence"
      ],
      "additionalProperties": false
    },
    "outstanding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "maxLength": 64
        },
        "severity": {
          "type": "string",
          "enum": [
            "blocker",
            "major",
            "minor"
          ]
        }
      },
      "required": [
        "id",
        "severity"
      ],
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "maxLength": 64
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "same_family": {
          "type": "boolean"
        },
        "choice": {
          "type": "string",
          "enum": [
            "picked-other-family",
            "picked-same-family",
            "given"
          ]
        }
      },
      "required": [
        "agent",
        "model",
        "family",
        "same_family",
        "choice"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "directory": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "instructions_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "marker": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$",
              "maxLength": 16
            },
            {
              "type": "null"
            }
          ]
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "minItems": 0,
          "maxItems": 128
        },
        "started": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "ended": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "elapsed_seconds": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_status": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -255,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "\\S"
        },
        "stdout": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "stderr": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_dropped_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "failed"
          ]
        },
        "verdict": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "ACCEPT",
                "CHANGES"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "record": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "type": "string",
          "enum": [
            "unchanged",
            "changed",
            "not checked"
          ]
        }
      },
      "required": [
        "attempt",
        "directory",
        "instructions_sha256",
        "marker",
        "argv",
        "started",
        "ended",
        "elapsed_seconds",
        "exit_status",
        "ended_by",
        "stdout",
        "stderr",
        "output_dropped_bytes",
        "status",
        "verdict",
        "reasons",
        "record",
        "repository"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/target"
        },
        "base": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "implementer_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "limit_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ACCEPT",
            "CHANGES",
            "FAILED"
          ]
        },
        "prior": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outstanding"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          },
          "minItems": 1,
          "maxItems": 2
        }
      },
      "required": [
        "target",
        "base",
        "implementer_family",
        "reviewer",
        "limit_seconds",
        "outcome",
        "prior",
        "attempts"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "const": 3
    },
    "shift_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "role": {
      "type": "string",
      "enum": [
        "driver",
        "builder",
        "reviewer"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "plan",
        "build",
        "review",
        "acknowledgment",
        "stop"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "brief": {
      "$ref": "#/$defs/artifact"
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "receipt_id",
    "version",
    "shift_id",
    "task_id",
    "request_id",
    "role",
    "phase",
    "round",
    "brief",
    "data"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "type": "string",
            "const": "plan"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/plan"
          },
          "role": {
            "type": "string",
            "const": "builder"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "type": "string",
            "const": "build"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/build"
          },
          "role": {
            "type": "string",
            "const": "builder"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "type": "string",
            "const": "review"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/review"
          },
          "role": {
            "type": "string",
            "const": "reviewer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "type": "string",
            "const": "acknowledgment"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/acknowledgment"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "type": "string",
            "const": "stop"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/stop"
          }
        }
      }
    }
  ]
}
